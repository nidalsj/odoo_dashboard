<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dashboard Owl Action -->
    <record id="odoo_dashboard_action" model="ir.actions.client">
        <field name="name">ODOO Dashboard</field>
        <field name="tag">odoo_dashboard</field>
    </record>

    <!-- Dashboard Menu Items -->
    <menuitem id="menu_odoo_dashboard"
        name="Dashboard"
        action="odoo_dashboard_action"
        web_icon="odoo_dashboard,static/description/icon.png"
    />

    <menuitem
        id="dashboard_date_filters_menu"
        name="Customize Date Filter"
        action="odoo_dashboard.dashboard_date_filter_action"
        parent="odoo_dashboard.menu_odoo_dashboard"
        sequence="1"
    />

    <menuitem
        id="dashboard_config_menu"
        name="Dashboard Settings"
        action="odoo_dashboard.dashboard_config_action"
        parent="odoo_dashboard.menu_odoo_dashboard"
        sequence="1"
    />

</odoo>
