<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="dashboard_config_view_form" model="ir.ui.view">
        <field name="name">dashboard.config.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Dashboard" string="Dashboard" name="odoo_dashboard">
                    <block title="Dashboard KPI Cards" name="dashboard_cards_settings_container">
                        <setting id="cards_color_settings" string="Dashboard Cards Background Colors">
                            <group>
                                <field name="total_customers_card_color" widget="color"/>
                                <field name="total_sales_card_color" widget="color"/>
                                <field name="total_purchases_card_color" widget="color"/>
                                <field name="sales_today_card_color" widget="color"/>
                            </group>
                        </setting>
                        <setting id="cards_taxt_color" string="Dashboard Cards Text Colors">
                            <group>
                                <field name="total_sales_text_color" widget="color"/>
                                <field name="total_purchases_text_color" widget="color"/>
                                <field name="total_customers_text_color" widget="color"/>
                                <field name="sales_today_text_color" widget="color"/>
                            </group>
                        </setting>
                    </block>
                    <block title="Dashboard Charts" name="dashboard_chart_settings_container">
                        <setting id="chart_color_settings" string="Dashboard Chart Colors">
                            <group>
                                <field name="delivery_chart_color" widget="color"/>
                                <field name="sale_orders_chart_color" widget="color"/>
                                <field name="top_products_chart_color" widget="color"/>
                                <field name="top_customers_chart_color" widget="color"/>
                            </group>
                        </setting>
                    </block>
                </app>
            </xpath>   
        </field>
    </record>
    
    <record id="dashboard_config_action" model="ir.actions.act_window">
        <field name="name">Dashboard Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'odoo_dashboard', 'bin_size': False}</field>
    </record>

    <menuitem
        id="dashboard_config_menu"
        name="Settings"
        action="odoo_dashboard.dashboard_config_action"
        parent="odoo_dashboard.menu_odoo_dashboard"
        sequence="1"
    />

</odoo>