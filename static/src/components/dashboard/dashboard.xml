<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_dashboard.OdooDashboard" owl="1">
        <div class="vh-100 overflow-auto bg-muted">
            <div class="col-lg-12">
                <!-- HEADER SECTION -->
                <div class="row mx-0">
                    <div class="col m-0 p-0">
                        <div class="shadow-sm border p-4 bg-white">
                            <div class="d-flex align-items-center justify-content-between p-1">
                                <h1 class="text-muted fw-bolder"><t t-esc="state.user"/>👋</h1>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- KPI CARDS SECTION -->
                <div class="col m-0 p-0">
                    <div class="row m-2">
                        <KpiCard name="'Total Sales'" icon="'fa fa-usd'" value="'50'" bgColor="'bg-white'" textColor="'text-danger'" />
                        <KpiCard name="'New Customers'" icon="'fa fa-user-plus'" value="state.new_customers.value" bgColor="'bg-white'" textColor="'text-info'" />
                        <KpiCard name="'Customers Today'" icon="'fa fa-user-plus'" value="'50'" bgColor="'bg-white'" textColor="'text-warning'" />
                        <KpiCard name="'Sales Today'" icon="'fa fa-line-chart'" value="'50'" bgColor="'bg-white'" textColor="'text-success'" />
                    </div>
                </div>

                <!-- CHARTS SECTION -->

                <!-- TABLES SECTION -->

            </div>
        </div>
    </t>
</templates>
