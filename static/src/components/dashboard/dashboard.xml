<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_dashboard.OdooDashboard" owl="1">
        <div class="vh-100 overflow-auto bg-muted">
            <div class="col-lg-12">
                <!-- HEADER SECTION -->
                <div class="row mx-0">
                    <div class="col m-0 p-0">
                        <div class="shadow-sm border p-4 bg-white">
                            <div class="d-flex align-items-center justify-content-between p-1">
                                <h1 class="text-dark fw-bold">Welcome <span class="text-muted"><t t-esc="state.user"/></span> 👋</h1>
                                <div>
                                    <!-- DATE FILTER -->
                                    <Dropdown>
                                        <button class="btn btn-secondary d-flex align-items-center gap-2 px-3 py-2" style="cursor: pointer !important;">
                                            <i class="fa fa-calendar me-2"></i>
                                            <t t-esc="state.selectedFilterName or 'Select Period'"/>
                                            <i class="fa fa-caret-down ms-2"></i>
                                        </button>
                                        <t t-set-slot="content">
                                            <t t-foreach="state.dateFilters" t-as="filter" t-key="filter.id">
                                                <DropdownItem class="'o_menu_item'" onSelected="() => this.onSelectFilter(filter)">
                                                    <t t-esc="filter.filter_name"/>
                                                </DropdownItem>
                                            </t>
                                        </t>
                                    </Dropdown>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- KPI CARDS SECTION -->
                <div class="col m-0 p-0">
                    <div class="row m-2">
                        <KpiCard name="'Total Sales'" icon="'fa fa-shopping-cart'" value="state.total_sales.value" bgColor="'bg-danger'" textColor="'text-white'" />
                        <KpiCard name="'Total Purchases'" icon="'fa fa-credit-card'" value="state.total_purchases.value" bgColor="'bg-info'" textColor="'text-white'" />
                        <KpiCard name="'Customers'" icon="'fa fa-handshake-o'" value="state.total_customers.value" bgColor="'bg-primary'" textColor="'text-white'" />
                        <KpiCard name="'Sales Today'" icon="'fa fa-line-chart'" value="state.sale_orders_today.value" bgColor="'bg-success'" textColor="'text-white'" />
                    </div>
                </div>
                <!-- CHARTS SECTION -->
                <div class="row m-2">
                    <div class="col-lg-6 m-0 p-0">
                        <div class="shadow-sm border m-2 p-4 bg-white" style="max-height: 550px;">
                            <div class="d-flex align-items-center justify-content-between">
                                <h3 class="text-dark fw-bold">Deliveries Today</h3>
                                <t t-if="!state.deliveryTodayChart.values.length">
                                    <span class="text-danger ms-2" style="font-size: 1rem; font-weight: bolder;">
                                        <i class="fa fa-info-circle me-2" />No records available
                                    </span>
                                </t>
                            </div>
                            <ChartLoader 
                                type="'bar'" 
                                title="'Deliveries'" 
                                axis="'y'"
                                labels="state.deliveryTodayChart.labels"
                                data="state.deliveryTodayChart.values"
                                datasetLabel="'Deliveries Today'"
                                color="'#17a2b8'"
                            />
                        </div>
                    </div>
                    <div class="col-lg-6 m-0 p-0">
                        <div class="shadow-sm border m-2 p-4 bg-white" style="max-height: 550px;">
                            <div class="d-flex align-items-center justify-content-between">
                                <h3 class="text-dark fw-bold">Monthly Sale Order Report</h3>
                                <t t-if="!state.saleMonthlyChart.values.length">
                                    <span class="text-danger ms-2" style="font-size: 1rem; font-weight: bolder;">
                                        <i class="fa fa-info-circle me-2" />No records available
                                    </span>
                                </t>
                            </div>
                            <ChartLoader 
                                type="'bar'" 
                                title="'Order Report'" 
                                axis="'x'"
                                labels="state.saleMonthlyChart.labels"
                                data="state.saleMonthlyChart.values"
                                datasetLabel="'Orders'"
                                color="'#ff752b'"
                            />
                        </div>
                    </div>
                    <div class="col-lg-4 m-0 p-0">
                        <div class="shadow-sm border m-2 p-4 bg-white" style="max-height: 550px;">
                            <div class="d-flex align-items-center justify-content-between">
                                <h3 class="text-dark fw-bold">Top 20 Products</h3>
                                <t t-if="!state.topProductsChart.values.length">
                                    <span class="text-danger ms-2" style="font-size: 1rem; font-weight: bolder;">
                                        <i class="fa fa-info-circle me-2" />No records available
                                    </span>
                                </t>
                            </div>
                            <ChartLoader 
                                type="'doughnut'" 
                                title="'Package'"
                                labels="state.topProductsChart.labels"
                                data="state.topProductsChart.values"
                                datasetLabel="'Orders'"
                            />
                        </div>
                    </div>
                    <div class="col-lg-8 m-0 p-0">
                        <div class="shadow-sm border m-2 p-4 bg-white" style="max-height: 550px;">
                            <div class="d-flex align-items-center justify-content-between">
                                <h3 class="text-dark fw-bold">Top Customers</h3>
                                <t t-if="!state.topCustomersChart.values.length">
                                    <span class="text-danger ms-2" style="font-size: 1rem; font-weight: bolder;">
                                        <i class="fa fa-info-circle me-2" />No records available
                                    </span>
                                </t>
                            </div>
                            <ChartLoader 
                                type="'bar'" 
                                title="'Plan Choice Analysis'" 
                                axis="'y'"
                                labels="state.topCustomersChart.labels"
                                data="state.topCustomersChart.values"
                                datasetLabel="'Amount'"
                                color="'#dc3545'"
                            />
                        </div>
                    </div>
                </div>
                <!-- TABLES SECTION -->
                <div class="row m-2">
                    <div class="col-lg-6 m-0 p-0">
                        <div class="shadow-sm border m-2 p-4 bg-white" style="height: 550px; display: flex; flex-direction: column;">
                            <div class="m-3">
                                <h3 class="mb-0">Upcoming Employee Birthdays 🎉</h3>
                            </div>
                            <div class="table-container">
                                <div class="table-header">
                                    <div class="table-cell text-nowrap" style="font-weight: bold;">Employee Name</div>
                                    <div class="table-cell text-nowrap" style="font-weight: bold;">Date of Birth</div>
                                    <div class="table-cell" style="width: 40px;"></div>
                                </div>
                                <div class="table-body">
                                    <t t-if="state.employeeBirthdays">
                                        <t t-foreach="state.employeeBirthdays" t-as="birthday" t-key="birthday.id">
                                            <div class="table-row">
                                                <div class="table-cell text-nowrap">
                                                    <t t-esc="birthday.display_name" />
                                                </div>
                                                <div class="table-cell text-nowrap">
                                                    <t t-esc="birthday.birthday" />
                                                </div>
                                                <div class="table-cell">
                                                    <i class="fa fa-pencil" style="cursor: pointer;" />
                                                </div>
                                            </div>
                                        </t>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 m-0 p-0">
                        <div class="shadow-sm border m-2 p-4 bg-white" style="height: 550px; display: flex; flex-direction: column;">
                            <div class="m-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <h3 class="mb-0">Tasks</h3>
                                
                                <div class="input-group w-auto" style="flex-grow: 1; max-width: 400px;">
                                    <input type="text" class="form-control" placeholder="Search Tasks here..." t-ref="search-input" t-on-keyup="searchTasks"/>
                                    <button class="btn btn-outline-secondary" t-on-click="searchTasks">Search</button>
                                </div>
                            
                                <button class="btn btn-dark rounded-circle" data-bs-toggle="modal" data-bs-target="#addtaskModal" title="Add Task">
                                    <i class="fa fa-plus"></i>
                                </button>
                            </div>
                            <div class="table-container" style="overflow-y: auto;">
                                <table class="table table-striped table-hover border mb-0">
                                    <tbody>
                                        <t t-if="state.taskList.length">
                                            <tr t-foreach="state.taskList" t-as="task" t-key="task.id">
                                                <td>
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" value="" t-att-id="task.id" t-att-checked="task.completed" t-on-click="(e)=>this.toggleTask(e,task)"/>
                                                        <label class="form-check-label" t-att-for="task.id" t-attf-class="#{task.completed and 'text-decoration-line-through'}">
                                                            <span t-esc="task.name"/>
                                                        </label>
                                                    </div>
                                                </td>
                                                <td style="text-align: right;">
                                                    <i class="fa fa-pencil me-4" style="cursor: pointer;" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#addtaskModal" 
                                                    t-on-click="()=>this.editTask(task)"/>

                                                    <i class="fa fa-trash" style="cursor: pointer;" 
                                                    t-on-click="()=>this.deleteTask(task)"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-else="">
                                            <tr>
                                                <td colspan="2" class="text-center text-danger py-4" style="font-size: 1rem; font-weight: bolder;">
                                                    <i class="fa fa-info-circle me-2"></i> No tasks available.
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <t t-call="odoo_dashboard.add_task_modal"/>
                    </div>
                    <div class="col-lg-6 m-0 p-0">
                        <div class="shadow-sm border m-2 p-4 bg-white" style="min-height: 550px;">
                            <div class="m-3">
                                <h3>Low Stock / Re-Order Alerts</h3>
                            </div>
                            <div class="table-container">
                                <div class="table-header">
                                    <div class="table-cell text-nowrap" style="font-weight: bold;">Display Name</div>
                                    <div class="table-cell text-nowrap" style="font-weight: bold;">Rating</div>
                                    <div class="table-cell" style="width: 40px;"></div>
                                </div>
                                <div class="table-body">
                                    <div class="table-row">
                                        <div class="table-cell text-nowrap">
                                            name
                                        </div>
                                        <div class="table-cell text-nowrap">
                                            value
                                        </div>
                                        <div class="table-cell">
                                            <i 
                                                class="fa fa-pencil" 
                                                style="cursor: pointer;" 
                                            />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 m-0 p-0">
                        <div class="shadow-sm border m-2 p-4 bg-white" style="min-height: 300px;">
                            <div class="m-3">
                                <h3>Invoice Payment Summary (All Companies)</h3>
                            </div>
                            <div class="table-container">
                                <div class="table-header">
                                    <div class="table-cell text-nowrap" style="font-weight: bold;">Status</div>
                                    <div class="table-cell text-nowrap" style="font-weight: bold; text-align: right;">Amount</div>
                                </div>
                                <div class="table-body">
                                    <t t-if="state.paymentsSummary">
                                        <div class="table-row">
                                            <div class="table-cell text-nowrap">Total Invoiced</div>
                                            <div class="table-cell text-nowrap" style="text-align: right;">
                                                <t t-esc="state.paymentsSummary.total_invoiced"/>
                                            </div>
                                        </div>
                                        <div class="table-row">
                                            <div class="table-cell text-nowrap">Total Paid</div>
                                            <div class="table-cell text-nowrap" style="text-align: right;">
                                                <t t-esc="state.paymentsSummary.total_paid"/>
                                            </div>
                                        </div>
                                        <div class="table-row">
                                            <div class="table-cell text-nowrap">Total Pending</div>
                                            <div class="table-cell text-nowrap" style="text-align: right;">
                                                <t t-esc="state.paymentsSummary.total_pending"/>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
