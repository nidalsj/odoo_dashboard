<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="odoo_dashboard.add_task_modal">
        <div class="modal fade" id="addtaskModal" tabindex="-1" aria-labelledby="taskModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="taskModalLabel" t-esc="state.isEdit ? 'Edit Task' : 'Add New Task'"/>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3 row">
                            <label for="name" class="col-sm-2 col-form-label">Task</label>
                            <div class="col-sm-10">
                                <input type="text" class="form-control" id="name" t-model="state.task.name" t-att-value="state.task.name"/>
                            </div>
                        </div>
    
                        <div class="mb-3 row">
                            <label for="completed" class="col-sm-2 col-form-label">Completed</label>
                            <div class="col-sm-10">
                                <input class="form-check-input" type="checkbox" t-model="state.task.completed" t-att-checked="state.task.completed" id="completed"/>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-dark" t-on-click="saveTask">Save Task</button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>